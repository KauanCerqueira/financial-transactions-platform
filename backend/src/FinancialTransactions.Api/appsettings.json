{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=financial_transactions;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Observability": {
    "ElasticsearchUri": ""
  },
  "RabbitMq": {
    "Uri": "",
    "QueueName": "transactions"
  },
  "Authentication": {
    "Authority": "",
    "Audience": "financial-transactions-api",
    "Issuers": []
  },
  "AllowedHosts": "*"
}
